{
  "expo": {
    "name": "Dead Link Saver",
    "slug": "dead-link-saver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "deadlinksaver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deadlinksaver.app"
    },
    "android": {
      "package": "com.deadlinksaver.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0e27"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e35c664-64b6-4463-b526-5d4c49ed9fd6"
      }
    }
  }
}
